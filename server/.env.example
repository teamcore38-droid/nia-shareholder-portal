# =============================================================================
# APEX LINK SHAREHOLDER PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# SECURITY NOTICE:
# - NEVER commit your real '.env' file or production credentials to Git.
# - Copy this file to '.env' (or 'server/.env') and fill in your actual credentials locally.
# - In production (e.g. Vercel, AWS, Render), configure these directly in your platform's
#   encrypted Environment Variables dashboard.
# =============================================================================

# Server Port & Runtime Environment ('development' | 'production' | 'test')
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local Instance)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/apex_shareholder_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/apex_shareholder_portal

# JSON Web Token (JWT) Cryptographic Secret Key
# CRITICAL: In production, must be at least 32 characters long and high-entropy.
# Generate a secure secret using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_jwt_secret_min_32_characters_random_hex

# Allowed CORS Origins (Comma-separated list of permitted frontend URLs)
# In development: defaults to localhost:5173, localhost:3000
# In production: set to your exact domain(s), e.g. https://shareholder.niagroup.com,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary Cloud Storage Configuration (Optional - File uploads fall back to local storage if empty)
# Get credentials from your Cloudinary Console (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=apex_shareholder_portal

# Development Only Flag: Allows local demo recovery/verification codes in responses
# Set to 'false' or leave empty in production.
ALLOW_DEV_DEMO_CODES=false
